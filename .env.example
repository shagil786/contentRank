DATABASE_URL=postgresql://outrank:replace-with-local-password@localhost:5433/outrank
REDIS_URL=redis://localhost:6379
# Normal checkout (used without ?test)
DODO_WEBHOOK_SECRET=replace-with-live-webhook-secret
DODO_PAYMENTS_API_KEY=replace-with-live-api-key
DODO_PRODUCT_ID=replace-with-live-product-id
DODO_API_BASE_URL=https://live.dodopayments.com

# Test checkout (used only with ?test=1 when explicitly enabled)
PAYMENT_TEST_MODE_ENABLED=false
DODO_TEST_WEBHOOK_SECRET=replace-with-test-webhook-secret
DODO_TEST_PAYMENTS_API_KEY=replace-with-test-api-key
DODO_TEST_PRODUCT_ID=replace-with-test-product-id
DODO_TEST_API_BASE_URL=https://test.dodopayments.com
CHECKOUT_BASE_URL=/checkout
YOUTUBE_API_KEY=replace-with-youtube-data-api-key
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=OUTRANK <notifications@example.com>
DISPUTE_ALERT_EMAIL=operations@example.com
APP_URL=http://localhost:3000
REALTIME_BASE_URL=http://localhost:3004
UNSUBSCRIBE_TOKEN_SECRET=replace-with-long-random-secret
# PostHog Cloud analytics (prefer the EU project/host for EU visitors).
# The project token is public by design; never put a PostHog personal API key here.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
DB_LOG_QUERIES=false
